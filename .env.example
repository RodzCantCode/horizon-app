# Copia este archivo como .env.local y rellénalo. Los valores salen del panel de Supabase
# (Project Settings → API Keys) o de las herramientas de supabase-horizon. Las dos son públicas por
# diseño; la clave secreta (service_role) no va aquí ni en ningún otro sitio de la app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
